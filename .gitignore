# ===================================
# Cafe Management System — .gitignore
# ===================================

# ── أسرار البيئة (لا تُرفع أبداً) ─────────────────────────────
.env
.env.local
.env.production
.env.staging
*.env

# ── مجلدات الحزم (تُعاد بـ npm install) ──────────────────────
node_modules/
backend/node_modules/

# ── ملفات البيانات المحلية (حساسة) ────────────────────────────
backend/data/*.json
backend/data/archive/
!backend/data/.gitkeep

# ── الصور المرفوعة (كبيرة + خاصة بكل كافيه) ───────────────────
backend/uploads/
!backend/uploads/.gitkeep

# ── رموز QR الطاولات (تُولَّد تلقائياً) ──────────────────────
table-qrs/
!table-qrs/.gitkeep

# ── ملفات Windows ────────────────────────────────────────────
Thumbs.db
desktop.ini
*.lnk

# ── ملفات نظام macOS ─────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── ملفات المحررات ───────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── ملفات Node.js المؤقتة ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ── ملفات التطوير المؤقتة ─────────────────────────────────────
scratch/
*.tmp
*.temp
visit2-fail-out.txt

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── ملفات Replit ─────────────────────────────────────────────
.replit
replit.nix
.local/
